 namespace {
 
+// This guard applies only to the fixed, noncentral rig initialization.
+struct MetricRay {
+  Eigen::Vector3d center;
+  Eigen::Vector3d ray;
+  Eigen::Matrix<double, 3, 2> jacobian;
+};
+
+using MetricMatch = std::pair<MetricRay, MetricRay>;
+
+double MetricResidual(const MetricMatch& match,
+                      const Eigen::Matrix3d& rotation,
+                      const Eigen::Vector3d& translation) {
+  const auto& [a, b] = match;
+  const Eigen::Vector3d u = rotation * a.ray;
+  const Eigen::Vector3d offset = rotation * a.center + translation - b.center;
+  const Eigen::Vector2d d1 =
+      (rotation * a.jacobian).transpose() * b.ray.cross(offset);
+  const Eigen::Vector2d d2 = b.jacobian.transpose() * offset.cross(u);
+  return u.cross(b.ray).dot(offset) /
+         std::sqrt(d1.squaredNorm() + d2.squaredNorm());
+}
+
+double MetricLogScaleSigma(const std::vector<MetricMatch>& matches,
+                           const Eigen::Matrix3d& rotation,
+                           const Eigen::Vector3d& translation) {
+  const double infinity = std::numeric_limits<double>::infinity();
+  if (matches.size() <= 6 || !translation.allFinite() ||
+      translation.norm() <= 0 || !rotation.allFinite()) {
+    return infinity;
+  }
+  const Eigen::Vector3d axis1 = translation.normalized().unitOrthogonal();
+  const Eigen::Vector3d axis2 = translation.normalized().cross(axis1);
+  const std::array<Eigen::Vector3d, 2> axes{axis1, axis2};
+  Eigen::Matrix<double, Eigen::Dynamic, 5> nuisance(matches.size(), 5);
+  Eigen::VectorXd scale(matches.size());
+  Eigen::VectorXd residuals(matches.size());
+  constexpr double h = 1e-5;
+  for (size_t row = 0; row < matches.size(); ++row) {
+    const MetricMatch& match = matches[row];
+    residuals(row) = MetricResidual(match, rotation, translation);
+    for (int i = 0; i < 3; ++i) {
+      const Eigen::Vector3d axis = Eigen::Vector3d::Unit(i);
+      nuisance(row, i) =
+          (MetricResidual(match, Eigen::AngleAxisd(h, axis) * rotation, translation) -
+           MetricResidual(match, Eigen::AngleAxisd(-h, axis) * rotation, translation)) /
+          (2 * h);
+    }
+    for (int i = 0; i < 2; ++i) {
+      nuisance(row, 3 + i) =
+          (MetricResidual(match, rotation, Eigen::AngleAxisd(h, axes[i]) * translation) -
+           MetricResidual(match, rotation, Eigen::AngleAxisd(-h, axes[i]) * translation)) /
+          (2 * h);
+    }
+    scale(row) =
+        (MetricResidual(match, rotation, std::exp(h) * translation) -
+         MetricResidual(match, rotation, std::exp(-h) * translation)) / (2 * h);
+  }
+  if (!nuisance.allFinite() || !scale.allFinite() || !residuals.allFinite()) {
+    return infinity;
+  }
+  const auto qr = nuisance.colPivHouseholderQr();
+  if (qr.rank() != 5) {
+    return infinity;
+  }
+  const double information = (scale - nuisance * qr.solve(scale)).norm();
+  const double noise = std::max(
+      1.0, residuals.norm() / std::sqrt(double(matches.size() - 6)));
+  return information > 0 ? noise / information : infinity;
+}
+
+bool MetricScaleIsObservable(double sigma) {
+  // Under the local linearized noise model, a 95% interval must distinguish
+  // the estimated translation length from half or twice that length.
+  return 1.96 * sigma < std::log(2.0);
+}
+
+double CheckMetricInitScale(
+    const std::vector<Eigen::Vector2d>& pixels1,
+    const std::vector<Eigen::Vector2d>& pixels2,
+    const std::vector<size_t>& idx1,
+    const std::vector<size_t>& idx2,
+    const std::vector<Rigid3d>& cam_from_rig,
+    const std::vector<Camera>& cameras,
+    const std::vector<char>& inliers,
+    const Rigid3d& pose) {
+  std::vector<MetricMatch> matches;
+  matches.reserve(inliers.size());
+  std::set<std::tuple<size_t, double, double>> seen1, seen2;
+  for (size_t i = 0; i < inliers.size(); ++i) {
+    if (!inliers[i]) continue;
+    const auto a = cameras[idx1[i]].CamRayFromImgWithJac(pixels1[i]);
+    const auto b = cameras[idx2[i]].CamRayFromImgWithJac(pixels2[i]);
+    if (!a || !b) continue;
+    const auto key1 = std::make_tuple(idx1[i], pixels1[i].x(), pixels1[i].y());
+    const auto key2 = std::make_tuple(idx2[i], pixels2[i].x(), pixels2[i].y());
+    if (seen1.count(key1) || seen2.count(key2)) continue;
+    seen1.insert(key1);
+    seen2.insert(key2);
+    const Rigid3d& ca = cam_from_rig[idx1[i]];
+    const Rigid3d& cb = cam_from_rig[idx2[i]];
+    const Eigen::Matrix3d ra = ca.rotation().inverse().toRotationMatrix();
+    const Eigen::Matrix3d rb = cb.rotation().inverse().toRotationMatrix();
+    matches.push_back({{ca.TgtOriginInSrc(), ra * a->ray, ra * a->jacobian},
+                       {cb.TgtOriginInSrc(), rb * b->ray, rb * b->jacobian}});
+  }
+  return MetricLogScaleSigma(
+      matches, pose.rotation().toRotationMatrix(), pose.translation());
+}
+void TestMetricGate() {
+  const Eigen::Matrix3d rotation =
+      Eigen::AngleAxisd(0.09, Eigen::Vector3d::UnitY()).toRotationMatrix();
+  const Eigen::Vector3d translation(1.8, 0.3, 0.4);
+  auto ray = [](const Eigen::Vector3d& point, const Eigen::Vector3d& center) {
+    const Eigen::Vector3d unit = (point - center).normalized();
+    Eigen::Matrix<double, 3, 2> jac =
+        -unit * unit.head<2>().transpose();
+    jac.topRows<2>().diagonal().array() += 1;
+    jac *= unit.z() / 1000.0;
+    return MetricRay{center, unit, jac};
+  };
+  for (bool noncentral : {true, false}) {
+    std::vector<MetricMatch> matches;
+    for (int i = 0; i < 240; ++i) {
+      const Eigen::Vector3d point(3 * std::sin(i * 0.53),
+                                  2 * std::cos(i * 0.31),
+                                  5 + i % 17);
+      const Eigen::Vector3d ca((i % 2) * noncentral, 0, 0);
+      const Eigen::Vector3d cb(((i / 2) % 2) * noncentral, 0, 0);
+      matches.emplace_back(ray(point, ca), ray(rotation * point + translation, cb));
+    }
+    const double sigma = MetricLogScaleSigma(matches, rotation, translation);
+    LOG(INFO) << "Synthetic noncentral " << noncentral << " log-scale sigma " << sigma;
+    if (MetricScaleIsObservable(sigma) != noncentral) {
+      throw std::runtime_error("Unexpected synthetic metric gate result");
+    }
+  }
+}
